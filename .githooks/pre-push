#!/usr/bin/env bash
# Pushing is manual only: every push needs a "yes" typed at a real terminal.
# Agents, scripts and IDE background jobs have no terminal, so their pushes fail.
set -euo pipefail
remote="$1"
url="$2"

if ! { exec 3</dev/tty; } 2>/dev/null; then
  echo "pre-push: blocked. Pushes to ${remote} must be run by hand from a terminal." >&2
  exit 1
fi

echo "About to push to ${remote} (${url})." > /dev/tty
printf 'Type "yes" to push: ' > /dev/tty
read -r answer <&3 || answer=""
exec 3<&-
if [[ "${answer}" != "yes" ]]; then
  echo "pre-push: push cancelled." >&2
  exit 1
fi
